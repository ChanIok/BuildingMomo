# Public browser origin, without a path or trailing slash.
MOMO_PUBLIC_ORIGIN=https://example.com
# Fill all three values. Empty values deliberately prevent startup.
# Generate a session key with: openssl rand -base64 32
MOMO_SESSION_KEY=
# Generate an independent admin token with: openssl rand -hex 32
MOMO_ADMIN_TOKEN=
# Keep the existing access passwords if users should continue using them.
MOMO_PASSWORDS=[]
