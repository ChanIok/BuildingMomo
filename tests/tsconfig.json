{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    // types 是整体覆盖而非合并，必须把 vite/client 一起写上，否则 src 里的 import.meta.env 会报错。
    "types": ["node", "vite/client"],
    // 测试只跑在 Node 上，可以放宽到 ES2022（app 的 DOM 目标仍是 ES2020）。
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // 测试代码只服务于编辑器内的类型提示与跳转。
    // 它不在根 tsconfig.json 的 references 里，因此不参与 npm run build。
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts"]
}
