#include <windows.h>
#include "build_info.h"

101 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BUILDINGMOMO_VERSION_YEAR,BUILDINGMOMO_VERSION_MONTH,BUILDINGMOMO_VERSION_DAY,BUILDINGMOMO_VERSION_HHMM
PRODUCTVERSION BUILDINGMOMO_VERSION_YEAR,BUILDINGMOMO_VERSION_MONTH,BUILDINGMOMO_VERSION_DAY,BUILDINGMOMO_VERSION_HHMM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef BUILDINGMOMO_DESKTOP_DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "BuildingMomo Desktop"
            VALUE "FileVersion", BUILDINGMOMO_VERSION_TEXT
            VALUE "InternalName", "BuildingMomo"
            VALUE "OriginalFilename", "BuildingMomo.exe"
            VALUE "ProductName", "BuildingMomo"
            VALUE "ProductVersion", BUILDINGMOMO_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
