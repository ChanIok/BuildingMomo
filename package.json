{
  "name": "BuildingMomo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:secure": "vite --mode secure",
    "build": "vue-tsc -b && vite build && node scripts/build-i18n.js",
    "build:cpp": "node scripts/build-cpp.js",
    "build:secure": "vue-tsc -b && vite build --mode secure && node scripts/build-i18n.js && node scripts/clean-seo-for-secure.js",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch-data": "node scripts/fetch-data.js",
    "prepare": "husky",
    "dev:cloud-sync-worker": "wrangler dev --config cloud-sync-worker/wrangler.jsonc",
    "dev:cloudflare-functions": "wrangler pages dev . --port 8788",
    "deploy:cloud-sync-worker": "wrangler deploy --config cloud-sync-worker/wrangler.jsonc",
    "deploy:cloudflare": "pnpm run build:secure && wrangler pages deploy dist --project-name buildingmomo-lab"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/deepseek": "3.0.73",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@fontsource-variable/inter": "^5.2.8",
    "@nuan5-pro/render": "github:nuan5-pro/infinity-nikki-web-render",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/vue-virtual": "3.13.46",
    "@tresjs/cientos": "^5.4.0",
    "@tresjs/core": "5.9.3",
    "@vueuse/core": "^14.2.1",
    "ai": "7.0.153",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "idb-keyval": "^6.2.2",
    "lucide-vue-next": "^0.575.0",
    "markstream-vue": "^2.0.20",
    "pinia": "^3.0.4",
    "pinyin-match": "^1.2.10",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "three": "^0.183.0",
    "three-mesh-bvh": "^0.9.8",
    "vue": "^3.5.28",
    "vue-sonner": "^2.0.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,md}": [
      "prettier --write"
    ]
  }
}
